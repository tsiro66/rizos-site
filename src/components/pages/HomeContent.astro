---
import { Image } from 'astro:assets';
import { localizedPath } from '../../i18n/utils';

/* ----------------------------------------------------------------------------
 * Shared assets: build a flat name -> ImageMetadata map across all image dirs.
 * Product images live in a subfolder, so we glob both patterns.
 * ------------------------------------------------------------------------- */
const allImages = {
  ...import.meta.glob<{ default: ImageMetadata }>('../../assets/*.{jpg,jpeg,png,webp}', { eager: true }),
  ...import.meta.glob<{ default: ImageMetadata }>('../../assets/products/*.{jpg,jpeg,png,webp}', { eager: true }),
};
const imageMap: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(allImages)) {
  const name = path.split('/').pop()!.split('.')[0];
  if (!imageMap[name]) imageMap[name] = mod.default;
}

/* ----------------------------------------------------------------------------
 * Products: load the content collection and resolve the featured subset.
 * Order is intentional and defines the left-to-right card order.
 * ------------------------------------------------------------------------- */
const productCollection = import.meta.glob<{ default: Record<string, any> }>(
  '../../content/products/*.json',
  { eager: true }
);
const productList: { slug: string; data: Record<string, any> }[] = [];
for (const [path, mod] of Object.entries(productCollection)) {
  const slug = path.split('/').pop()!.replace('.json', '');
  productList.push({ slug, data: mod.default });
}

const featuredSlugs = [
  'feta',
  'graviera-ageladinh',
  'katsikisio-tyri',
  'anthotiro',
  'kefaloturi-proveio',
  'proveio-voutyro',
];

interface FeaturedProduct {
  slug: string;
  name: string;
  image: string;
  imageAlt: string;
}

interface Props {
  t: <T = unknown>(key: string) => T;
  locale: string;
}

const { t, locale } = Astro.props;

const featuredProducts: FeaturedProduct[] = featuredSlugs
  .map((slug) => {
    const data = productList.find((p) => p.slug === slug)?.data;
    if (!data) return null;
    const l = data[locale] as { name: string; image: string; imageAlt: string };
    return { slug, ...l };
  })
  .filter((p): p is FeaturedProduct => p !== null);

const highlightIcons = ['milk', 'leaf', 'clock', 'shield'] as const;
const highlights = (
  t('highlights') as { title: string; description: string }[]
).map((h, i) => ({ ...h, icon: highlightIcons[i] ?? 'leaf' }));
---

<!-- ============================= Hero ============================= -->
<section class="relative h-[95svh] md:h-svh overflow-hidden">
  <Image
    src={imageMap[t('hero.image') as string] ?? imageMap['tyrnavos']}
    alt={t('hero.imageAlt')}
    width={1920}
    format="webp"
    quality={80}
    class="absolute inset-0 w-full h-full object-cover object-[56%_50%] md:object-center"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-black/30 via-black/10 to-transparent"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
  <div class="relative z-10 flex flex-col items-center md:items-start justify-center h-full text-center md:text-left px-6 md:px-16 lg:px-24 max-w-4xl mx-auto md:mx-0 -translate-y-[16svh] md:translate-y-0">
    <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold font-alegreya leading-tight text-white drop-shadow-lg max-w-2xl">
      {t('hero.title')}
    </h1>
    {t('hero.subtitle') ? (
      <p class="mt-6 text-base md:text-lg lg:text-xl font-noto-sans font-light text-white/85 max-w-xl leading-relaxed">
        {t('hero.subtitle')}
      </p>
    ) : null}
    <a
      href={localizedPath('/products', locale)}
      class="mt-10 inline-block bg-olive-800 text-white font-geologica font-semibold tracking-widest uppercase text-sm px-10 py-4 hover:bg-olive-900 transition-colors duration-300 shadow-lg"
    >
      {t('hero.cta')}
    </a>
  </div>
</section>

<!-- ======================= Story & Featured ======================= -->
<section class="bg-amber-50">
  <div class="max-w-6xl mx-auto px-8 md:px-16 lg:px-24 py-20 md:py-28">

    <!-- Top row: story text + portrait image -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-12 items-center">
      <div class="lg:col-span-3 flex flex-col justify-center">
        <span class="text-sm font-geologica font-semibold tracking-widest uppercase text-red-800 mb-4">
          {t('story.eyebrow')}
        </span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-alegreya leading-tight text-stone-900">
          {t('story.heading')}
        </h2>
        <p class="mt-6 text-base md:text-lg font-noto-sans text-stone-600 max-w-2xl leading-relaxed">
          {t('story.body')}
        </p>
        <a
          href={localizedPath('/about', locale)}
          class="mt-8 inline-flex items-center gap-3 self-start border border-stone-900 text-stone-900 font-geologica font-semibold text-sm tracking-widest uppercase px-8 py-3 hover:bg-stone-900 hover:text-white transition-colors duration-300"
        >
          {t('story.cta')}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <div class="lg:col-span-2">
        <div class="overflow-hidden rounded-lg border border-stone-300/70 shadow-sm">
          <Image
            src={imageMap[t('story.image') as string] ?? imageMap['history']}
            alt={t('story.imageAlt')}
            width={1024}
            format="webp"
            quality={80}
            loading="lazy"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>

    <!-- Bottom row: featured product cards -->
    <div class="mt-24 md:mt-32">
      <div class="text-center mb-12">
        <span class="text-sm font-geologica font-semibold tracking-widest uppercase text-red-800 block mb-4">
          {t('featured.label')}
        </span>
        <h2 class="text-3xl md:text-5xl font-alegreya text-stone-900">
          {t('featured.title')}
        </h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 md:gap-4">
        {featuredProducts.map((product) => (
          <a
            href={localizedPath(`/products/${product.slug}`, locale)}
            class="group flex flex-col h-full border border-stone-200 rounded-lg overflow-hidden hover:border-olive-800 hover:shadow-md transition-all duration-300"
          >
            <div class="aspect-square bg-amber-100 overflow-hidden">
              {product.image && imageMap[product.image] ? (
                <Image
                  src={imageMap[product.image]}
                  alt={product.imageAlt}
                  width={400}
                  format="webp"
                  quality={80}
                  loading="lazy"
                  class="w-full h-full object-cover"
                />
              ) : (
                <span class="text-stone-400 font-alegreya text-xs">{product.imageAlt}</span>
              )}
            </div>
            <div class="p-3 md:p-4 flex flex-col items-center text-center flex-1">
              <h3 class="font-alegreya text-sm md:text-[15px] text-stone-900 leading-snug">
                {product.name}
              </h3>
            </div>
          </a>
        ))}
      </div>

      <!-- Bottom CTA -->
      <div class="mt-14 flex justify-center">
        <a
          href={localizedPath('/products', locale)}
          class="inline-block bg-olive-800 text-white font-geologica font-semibold tracking-widest uppercase text-sm md:text-base px-10 py-4 hover:bg-olive-900 transition-colors duration-300 shadow"
        >
          {t('featured.cta')}
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ========================= Highlights strip ===================== -->
<section class="bg-olive-800 py-20">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-10 md:gap-6 text-center">
    {highlights.map((h) => (
      <div class="flex flex-col items-center">
        <div class="w-16 h-16 mx-auto mb-5 rounded-full bg-amber-50/10 flex items-center justify-center">
          {h.icon === 'milk' && (
            <svg class="w-8 h-8 text-amber-50" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 3h8l2 4.5V19a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V7.5L8 3z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 7.5h12"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6"></path>
            </svg>
          )}
          {h.icon === 'leaf' && (
            <svg class="w-8 h-8 text-amber-50" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 20c0-8 5-13 16-13 0 8-5 13-16 13z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 20C8 16 11 13 17 8"></path>
            </svg>
          )}
          {h.icon === 'clock' && (
            <svg class="w-8 h-8 text-amber-50" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="9" stroke-linecap="round" stroke-linejoin="round"></circle>
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5V12l3.5 2"></path>
            </svg>
          )}
          {h.icon === 'shield' && (
            <svg class="w-8 h-8 text-amber-50" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3v5c0 5-3 7.5-7 9-4-1.5-7-4-7-9V6l7-3z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"></path>
            </svg>
          )}
        </div>
        <h3 class="font-geologica font-semibold tracking-widest uppercase text-base md:text-lg text-amber-50">{h.title}</h3>
        <p class="mt-3 text-sm font-noto-sans leading-relaxed text-amber-100/80 max-w-[28ch]">{h.description}</p>
      </div>
    ))}
  </div>
</section>

<!-- ============================= CTA ============================== -->
<section class="relative py-24 bg-amber-50 overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-red-800 to-transparent"></div>
  </div>
  <div class="relative z-10 max-w-3xl mx-auto px-6 text-center">
    <span class="block mb-4 text-sm font-geologica font-semibold tracking-widest uppercase text-red-800">{t('cta.eyebrow')}</span>
    <h2 class="text-3xl md:text-5xl font-alegreya text-stone-900 leading-tight">
      {t('cta.title')}
    </h2>
    <p class="mt-6 text-lg md:text-xl font-noto-sans text-stone-600 leading-relaxed">
      {t('cta.subtitle')}
    </p>
    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={localizedPath('/contact', locale)}
        class="inline-block bg-olive-800 text-white font-geologica font-semibold tracking-widest uppercase text-sm px-10 py-4 hover:bg-olive-900 transition-colors duration-300 shadow-lg"
      >
        {t('cta.btn1')}
      </a>
      <a
        href={localizedPath('/products', locale)}
        class="inline-block border border-stone-900 text-stone-900 font-geologica font-semibold tracking-widest uppercase text-sm px-10 py-4 hover:bg-stone-900 hover:text-white transition-colors duration-300"
      >
        {t('cta.btn2')}
      </a>
    </div>
  </div>
</section>