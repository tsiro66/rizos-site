---
import { localizedPath } from '../../i18n/utils';
import { Image } from 'astro:assets';

const allImages = {
  ...import.meta.glob<{ default: ImageMetadata }>('../../assets/*.{jpg,jpeg,png,webp}', { eager: true }),
  ...import.meta.glob<{ default: ImageMetadata }>('../../assets/products/*.{jpg,jpeg,png,webp}', { eager: true }),
};
const productImages: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(allImages)) {
  const filename = path.split('/').pop()!.split('.')[0];
  if (!productImages[filename]) productImages[filename] = mod.default;
}

const productCollection = import.meta.glob<{ default: Record<string, any> }>('../../content/products/*.json', { eager: true });
const productList: { slug: string; data: Record<string, any> }[] = [];
for (const [path, mod] of Object.entries(productCollection)) {
  const slug = path.split('/').pop()!.replace('.json', '');
  productList.push({ slug, data: mod.default });
}

interface Props {
  t: <T = unknown>(key: string) => T;
  locale: string;
}

const { t, locale } = Astro.props;

const productItems = productList.map(({ slug, data }) => {
  const localeData = data[locale] as { name: string; description: string; imageAlt: string; image: string };
  return { slug, ...localeData };
});
---

<!-- Hero -->
<section class="bg-amber-50 pt-32 pb-16">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <span class="text-sm font-geologica font-semibold tracking-widest uppercase text-red-800 mb-4 block">{t('hero.label')}</span>
    <h1 class="text-4xl md:text-6xl font-alegreya font-bold text-stone-900 leading-tight">
      {t('hero.title')}
    </h1>
    <p class="mt-6 text-lg md:text-xl font-noto-sans text-stone-600 max-w-2xl mx-auto leading-relaxed">
      {t('hero.subtitle')}
    </p>
  </div>
</section>

<!-- Product Grid -->
<section class="py-24 bg-amber-50">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 md:gap-5">
      {
        productItems.map((product, i) => (
          <a href={localizedPath(`/products/${product.slug}`, locale)} class="group rounded-lg overflow-hidden border border-stone-300 bg-transparent hover:border-olive-800 transition-colors duration-300 block">
            <div class="aspect-square bg-amber-50 flex items-center justify-center overflow-hidden">
              {product.image && productImages[product.image] ? (
                <Image
                  src={productImages[product.image]}
                  alt={product.imageAlt}
                  width={400}
                  widths={[200, 400]}
                  sizes="(min-width: 1280px) 240px, (min-width: 1024px) 270px, (min-width: 640px) 35vw, 50vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
              ) : (
                <span class="text-stone-400 font-geologica text-sm">{product.imageAlt}</span>
              )}
            </div>
            <div class="p-4">
              <h2 class="text-base font-alegreya font-bold text-stone-900 leading-snug">{product.name}</h2>
              <p class="mt-1.5 text-sm font-noto-sans text-stone-600 leading-snug line-clamp-2">
                {product.description}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<!-- CTA -->
<section class="py-20 bg-amber-50">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <h2 class="text-2xl md:text-4xl font-alegreya font-bold text-stone-900">
      {t('cta.title')}
    </h2>
    <p class="mt-4 text-lg font-noto-sans text-stone-600">
      {t('cta.subtitle')}
    </p>
    <a
      href={localizedPath('/contact', locale)}
      class="mt-8 inline-block bg-olive-800 text-white font-geologica font-semibold tracking-widest uppercase text-sm px-10 py-4 hover:bg-olive-900 transition-colors duration-300 shadow-lg"
    >
      {t('cta.btn')}
    </a>
  </div>
</section>
