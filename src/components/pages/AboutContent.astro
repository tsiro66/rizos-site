---
import { Image } from 'astro:assets';

interface Props {
  t: <T = unknown>(key: string) => T;
  locale: string;
}

const { t } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/*.{jpg,jpeg,png,webp}', { eager: true });
const imageMap: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(allImages)) {
  const name = path.split('/').pop()!.split('.')[0];
  if (!imageMap[name]) imageMap[name] = mod.default;
}

const paragraphs = (t('story.paragraphs') as string[]) ?? [];
const storyParts = paragraphs
  .flatMap((p) => String(p).split(/\n{2,}/).map((s) => s.trim()))
  .filter(Boolean);

const timelineItems = t('timeline.items') as { year: string; title: string; role: string; text: string }[];
---

<!-- Hero -->
<section class="bg-amber-50 pt-32 pb-16">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <span class="text-sm font-geologica font-semibold tracking-widest uppercase text-red-800 mb-4 block">{t('hero.label')}</span>
    <h1 class="text-4xl md:text-6xl font-alegreya font-bold text-stone-900 leading-tight">
      {t('hero.title')}
    </h1>
    <p class="mt-6 text-lg md:text-xl font-noto-sans text-stone-600 max-w-2xl mx-auto leading-relaxed">
      {t('hero.subtitle')}
    </p>
  </div>
</section>

<!-- Story + Timeline -->
<section class="py-24 bg-amber-50">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl">
      <span class="text-sm font-geologica font-semibold tracking-widest uppercase text-red-800 mb-4 block">{t('story.label')}</span>
      <h2 class="text-3xl md:text-4xl font-alegreya font-bold text-stone-900 leading-tight">
        {t('story.title')}
      </h2>
    </div>

    <div class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <!-- Portrait -->
      <div class="lg:sticky lg:top-32">
        <div class="overflow-hidden rounded-lg border border-stone-300/70 shadow-sm aspect-[2/3]">
          <Image
            src={imageMap['history']}
            alt={t('story.title') as string}
            width={1024}
            format="webp"
            quality={80}
            loading="lazy"
            class="w-full h-full object-cover"
          />
        </div>
      </div>

      <!-- Timeline + prose -->
      <div>
        <ol class="space-y-10">
          {timelineItems.map((item) => (
            <li class="relative pl-8 border-l border-stone-300">
              <span class="absolute -left-[7px] top-1 w-3 h-3 rounded-full bg-olive-800"></span>
              <span class="block text-sm font-geologica font-semibold tracking-widest uppercase text-red-800">{item.year}</span>
              <h3 class="mt-1 text-xl font-alegreya font-bold text-stone-900">{item.title}</h3>
              <p class="mt-0.5 text-sm font-geologica text-olive-700">{item.role}</p>
              <p class="mt-3 text-base font-noto-sans text-stone-600 leading-relaxed">{item.text}</p>
            </li>
          ))}
        </ol>

        <div class="mt-12 pt-10 border-t border-stone-300 space-y-6">
          {
            storyParts.map((para) => (
              <p class="text-base font-noto-sans text-stone-600 leading-relaxed">{para}</p>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>