---
import { Image } from 'astro:assets';

const allImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/*.{jpg,jpeg,png,webp}', { eager: true });
const imageMap: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(allImages)) {
  const filename = path.split('/').pop()!.split('.')[0];
  imageMap[filename] = mod.default;
}

interface Props {
  t: <T = unknown>(key: string) => T;
  locale: string;
}

const { t } = Astro.props;

const overviewImageKey = t('overview.image') as string;
const overviewImage = overviewImageKey && imageMap[overviewImageKey] ? imageMap[overviewImageKey] : null;
const galleryItems = t('gallery.items') as { image: string; alt: string }[];
---

<!-- Hero -->
<section class="bg-amber-50 pt-32 pb-16">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <span class="text-sm font-geologica font-semibold tracking-widest uppercase text-red-800 mb-4 block">{t('hero.label')}</span>
    <h1 class="text-4xl md:text-6xl font-alegreya font-bold text-stone-900 leading-tight">
      {t('hero.title')}
    </h1>
    <p class="mt-6 text-lg md:text-xl font-noto-sans text-stone-600 max-w-2xl mx-auto leading-relaxed">
      {t('hero.subtitle')}
    </p>
  </div>
</section>

<!-- Overview -->
<section class="py-24 bg-amber-50">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
    <div>
      <span class="text-sm font-geologica font-semibold tracking-widest uppercase text-red-800 mb-4 block">{t('overview.label')}</span>
      <h2 class="text-3xl md:text-4xl font-alegreya font-bold text-stone-900 leading-tight">
        {t('overview.title')}
      </h2>
      <p class="mt-6 text-lg font-noto-sans text-stone-600 leading-relaxed">
        {t('overview.para1')}
      </p>
      <p class="mt-4 text-lg font-noto-sans text-stone-600 leading-relaxed">
        {t('overview.para2')}
      </p>
    </div>
    <div class="aspect-[4/3] rounded-2xl overflow-hidden">
      {overviewImage ? (
        <Image src={overviewImage} alt={t('overview.imageAlt')} width={960} format="webp" quality={80} class="w-full h-full object-cover" />
      ) : (
        <div class="w-full h-full bg-amber-50 flex items-center justify-center">
          <span class="text-stone-400 font-geologica text-sm">{t('overview.imageAlt')}</span>
        </div>
      )}
    </div>
  </div>
</section>

<!-- Gallery -->
<section class="py-24 bg-amber-50">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="text-sm font-geologica font-semibold tracking-widest uppercase text-red-800 mb-4 block">{t('gallery.label')}</span>
      <h2 class="text-3xl md:text-4xl font-alegreya font-bold text-stone-900">
        {t('gallery.title')}
      </h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {
        galleryItems.map((item: { image: string; alt: string }) => {
          const img = item.image && imageMap[item.image] ? imageMap[item.image] : null;
          return (
            <div class="aspect-square rounded-xl overflow-hidden">
              {img ? (
                <Image src={img} alt={item.alt} width={600} format="webp" quality={80} class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full bg-amber-50 flex items-center justify-center">
                  <span class="text-stone-400 font-geologica text-sm">{item.alt}</span>
                </div>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>