---
import { Image } from 'astro:assets';

const allImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/*.{jpg,jpeg,png,webp}', { eager: true });
const imageMap: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(allImages)) {
  const filename = path.split('/').pop()!.split('.')[0];
  imageMap[filename] = mod.default;
}

interface Props {
  t: <T = unknown>(key: string) => T;
  locale: string;
}

const { t } = Astro.props;

const stats = (t('stats') as { value: string; label: string }[]) ?? [];
const productionImage = imageMap['factory'];
const facilityImage = imageMap['factory2'];
---

<!-- Hero -->
<section class="bg-amber-50 pt-32 pb-16">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <span class="text-sm font-geologica font-semibold tracking-widest uppercase text-red-800 mb-4 block">{t('hero.label')}</span>
    <h1 class="text-4xl md:text-6xl font-alegreya font-bold text-stone-900 leading-tight">
      {t('hero.title')}
    </h1>
    <p class="mt-6 text-lg md:text-xl font-noto-sans text-stone-600 max-w-2xl mx-auto leading-relaxed">
      {t('hero.subtitle')}
    </p>
  </div>
</section>

<!-- Facts strip -->
{
  stats.length > 0 && (
    <section class="bg-olive-800 py-12">
      <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
        {stats.map((s) => (
          <div>
            <span class="block text-4xl md:text-5xl font-alegreya font-bold text-amber-50">{s.value}</span>
            <span class="mt-2 block text-sm font-geologica font-semibold tracking-widest uppercase text-amber-100/80">{s.label}</span>
          </div>
        ))}
      </div>
    </section>
  )
}

<!-- Production: text + factory.jpg -->
<section class="py-24 bg-amber-50">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
    <div class="lg:col-span-5">
      <span class="text-sm font-geologica font-semibold tracking-widest uppercase text-red-800 mb-4 block">{t('production.label')}</span>
      <h2 class="text-3xl md:text-4xl font-alegreya font-bold text-stone-900 leading-tight">
        {t('production.title')}
      </h2>
      <p class="mt-6 text-lg font-noto-sans text-stone-600 leading-relaxed">
        {t('production.para1')}
      </p>
      <p class="mt-4 text-lg font-noto-sans text-stone-600 leading-relaxed">
        {t('production.para2')}
      </p>
    </div>
    <div class="lg:col-span-7">
      <div class="aspect-[4/5] rounded-2xl overflow-hidden shadow-md">
        <Image src={productionImage} alt={t('production.title')} width={900} format="webp" quality={80} loading="lazy" class="w-full h-full object-cover" />
      </div>
    </div>
  </div>
</section>

<!-- Facility: factory2.jpg + text -->
<section class="pb-24 bg-amber-50">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
    <div class="lg:col-span-7 order-2 lg:order-1">
      <div class="aspect-[4/5] rounded-2xl overflow-hidden shadow-md">
        <Image src={facilityImage} alt={t('facility.title')} width={900} format="webp" quality={80} loading="lazy" class="w-full h-full object-cover" />
      </div>
    </div>
    <div class="lg:col-span-5 order-1 lg:order-2">
      <span class="text-sm font-geologica font-semibold tracking-widest uppercase text-red-800 mb-4 block">{t('facility.label')}</span>
      <h2 class="text-3xl md:text-4xl font-alegreya font-bold text-stone-900 leading-tight">
        {t('facility.title')}
      </h2>
      <p class="mt-6 text-lg font-noto-sans text-stone-600 leading-relaxed">
        {t('facility.para1')}
      </p>
      <p class="mt-4 text-lg font-noto-sans text-stone-600 leading-relaxed">
        {t('facility.para2')}
      </p>
    </div>
  </div>
</section>
