---
import { localizedPath, locales } from '../i18n/utils';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

interface Props {
  t: <T = unknown>(key: string) => T;
  locale: string;
}
const { t, locale } = Astro.props;

const currentPath = (() => {
  const pathname = Astro.url.pathname;
  if (locale === 'el') return pathname;
  const prefix = `/${locale}`;
  return pathname.startsWith(prefix) ? (pathname.slice(prefix.length) || '/') : pathname;
})();

const isHome = currentPath === '/';

const isActive = (p: string) => currentPath === p || currentPath.startsWith(p !== '/' ? `${p}/` : '__none__');
const navLinkClass = (p: string) => [
  'transition-colors duration-300 nav-link',
  isActive(p) ? 'text-red-800 underline' : 'text-olive-700 no-underline hover:text-red-800',
].join(' ');
---

<nav
  id="main-nav"
  data-transparent-scroll={isHome}
  class:list={[
    'fixed top-0 left-0 right-0 z-[60] transition-[background-color,box-shadow] duration-300',
    isHome ? 'nav-transparent bg-transparent shadow-none' : 'bg-amber-50 shadow-none',
  ]}
>
  <div class="relative max-w-11/12 mx-auto flex items-center justify-between px-6 py-3">
    <a href={localizedPath('/', locale)} class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 md:static md:translate-x-0 md:translate-y-0 inline-flex items-center leading-none transition-opacity duration-300 hover:opacity-90" aria-label={t('nav.brand')}>
      <Image src={logo} alt={t('nav.brand')} height={160} format="webp" quality={90} class="h-16 w-auto" loading="eager" />
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex gap-10 md:gap-16 list-none m-0 p-0 text-lg font-alegreya">
      <li><a href={localizedPath('/about', locale)} class={navLinkClass('/about')}>{t('nav.about')}</a></li>
      <li><a href={localizedPath('/products', locale)} class={navLinkClass('/products')}>{t('nav.products')}</a></li>
      <li><a href={localizedPath('/factory', locale)} class={navLinkClass('/factory')}>{t('nav.factory')}</a></li>
      <li><a href={localizedPath('/contact', locale)} class={navLinkClass('/contact')}>{t('nav.contact')}</a></li>
    </ul>

    <!-- Locale switcher - desktop -->
    <div class="hidden md:flex items-center gap-1.5 ml-2 text-sm font-alegreya">
      {
        locales.map((l, i) => {
          const label = { el: 'ΕΛ', en: 'EN', de: 'DE' }[l];
          return [
            i > 0 && <span class="locale-pipe transition-colors duration-300 text-stone-300">|</span>,
            l === locale
              ? <span class="locale-active transition-colors duration-300 font-semibold text-red-800 underline">{label}</span>
              : <a href={localizedPath(currentPath, l)} class="locale-link no-underline transition-colors duration-300 text-olive-700 hover:text-red-800">{label}</a>
          ];
        })
      }
    </div>

    <!-- Mobile hamburger (2 lines) -->
    <button id="mobile-menu-btn" class="ml-auto md:ml-0 md:hidden flex flex-col justify-center gap-[7px] w-9 h-9 cursor-pointer bg-transparent border-none z-[60]" aria-label="Menu">
      <span class="hamburger-line block w-full h-[2px] transition-all duration-300 bg-stone-800"></span>
      <span class="hamburger-line block w-full h-[2px] transition-all duration-300 bg-stone-800"></span>
    </button>
  </div>
</nav>

<!-- Fullscreen mobile menu -->
<div id="mobile-menu" class="fixed inset-0 z-[55] bg-red-800 flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-300">
  <a href={localizedPath('/about', locale)} class="text-white text-3xl font-alegreya no-underline hover:opacity-80 transition-opacity">{t('nav.about')}</a>
  <a href={localizedPath('/products', locale)} class="text-white text-3xl font-alegreya no-underline hover:opacity-80 transition-opacity">{t('nav.products')}</a>
  <a href={localizedPath('/factory', locale)} class="text-white text-3xl font-alegreya no-underline hover:opacity-80 transition-opacity">{t('nav.factory')}</a>
  <a href={localizedPath('/contact', locale)} class="text-white text-3xl font-alegreya no-underline hover:opacity-80 transition-opacity">{t('nav.contact')}</a>

  <!-- Locale switcher - mobile -->
  <div class="flex items-center gap-3 mt-6 text-xl font-alegreya">
    {
      locales.map((l, i) => {
        const label = { el: 'ΕΛ', en: 'EN', de: 'DE' }[l];
        return [
          i > 0 && <span class="text-white/30">|</span>,
          l === locale
            ? <span class="text-white font-bold">{label}</span>
            : <a href={localizedPath(currentPath, l)} class="text-white/60 hover:text-white transition-colors no-underline">{label}</a>
        ];
      })
    }
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const nav = document.getElementById('main-nav');
    if (!nav) return;

    const hamburgerLines = nav.querySelectorAll('.hamburger-line');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    let menuOpen = false;

    // Scroll-linked nav state (shadow, and transparency on home). Nav is
    // re-rendered on view transitions but `window` persists, so drop any
    // previous handler.
    const transparentScroll = nav.dataset.transparentScroll === 'true';
    function applyNavState(solid: boolean) {
      if (solid) {
        nav.classList.remove('nav-transparent', 'bg-transparent', 'shadow-none');
        nav.classList.add('bg-amber-50', 'shadow-md');
      } else {
        nav.classList.add('nav-transparent', 'bg-transparent', 'shadow-none');
        nav.classList.remove('bg-amber-50', 'shadow-md');
      }
    }
    function updateNavOnScroll() {
      if (menuOpen) return;
      // Home: transparent + light text at top, solid + shadow after 24px.
      // Other pages: amber bg always, shadow only once scrolled.
      const solid = window.scrollY > (transparentScroll ? 24 : 0);
      if (transparentScroll) applyNavState(solid);
      else {
        nav.classList.toggle('shadow-md', solid);
        nav.classList.toggle('shadow-none', !solid);
      }
      const lightText = transparentScroll && !solid;
      hamburgerLines.forEach((l) => {
        l.classList.toggle('bg-white', lightText);
        l.classList.toggle('bg-stone-800', !lightText);
      });
    }
    if (window.__navScrollHandler) {
      window.removeEventListener('scroll', window.__navScrollHandler);
      window.__navScrollHandler = undefined;
    }
    window.__navScrollHandler = updateNavOnScroll;
    window.addEventListener('scroll', updateNavOnScroll, { passive: true });
    updateNavOnScroll();

    function toggleMenu() {
      menuOpen = !menuOpen;
      if (menuOpen) {
        mobileMenu!.classList.remove('opacity-0', 'pointer-events-none');
        mobileMenu!.classList.add('opacity-100', 'pointer-events-auto');
        applyNavState(false); // transparent so the red menu shows behind nav
        hamburgerLines.forEach(l => {
          l.classList.remove('bg-stone-800');
          l.classList.add('bg-white');
        });
        const lines = Array.from(hamburgerLines) as HTMLElement[];
        lines[0].style.transform = 'translateY(4.5px) rotate(45deg)';
        lines[1].style.transform = 'translateY(-4.5px) rotate(-45deg)';
        document.body.style.overflow = 'hidden';
      } else {
        mobileMenu!.classList.add('opacity-0', 'pointer-events-none');
        mobileMenu!.classList.remove('opacity-100', 'pointer-events-auto');
        const lines = Array.from(hamburgerLines) as HTMLElement[];
        lines[0].style.transform = '';
        lines[1].style.transform = '';
        document.body.style.overflow = '';
        updateNavOnScroll();
      }
    }

    menuBtn?.addEventListener('click', toggleMenu);

    mobileMenu?.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        if (menuOpen) toggleMenu();
      });
    });
  });
</script>

<style>
  /* Light link/switcher colors while nav floats over the hero image. */
  #main-nav.nav-transparent .nav-link,
  #main-nav.nav-transparent .nav-link:hover {
    color: #fff;
  }
  #main-nav.nav-transparent .locale-active,
  #main-nav.nav-transparent .locale-link,
  #main-nav.nav-transparent .locale-link:hover {
    color: #fff;
  }
  #main-nav.nav-transparent .locale-pipe {
    color: rgb(255 255 255 / 0.4);
  }
</style>

