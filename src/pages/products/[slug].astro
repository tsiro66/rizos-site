---
import MainLayout from '../../layouts/MainLayout.astro';
import ProductDetailContent from '../../components/pages/ProductDetailContent.astro';
import { useTranslations } from '../../i18n/utils';
import { getImage } from 'astro:assets';

const productModules = import.meta.glob<{ default: Record<string, any> }>('../../content/products/*.json', { eager: true });
const productMap: Record<string, any> = {};
for (const [path, mod] of Object.entries(productModules)) {
  const slug = path.split('/').pop()!.replace('.json', '');
  productMap[slug] = mod.default;
}

const allImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/*.{jpg,jpeg,png,webp}', { eager: true });
const productImageFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/products/*.{jpg,jpeg,png,webp}', { eager: true });
const imageMap: Record<string, ImageMetadata> = {};
for (const mods of [allImages, productImageFiles]) {
  for (const [path, mod] of Object.entries(mods)) {
    const filename = path.split('/').pop()!.split('.')[0];
    if (!imageMap[filename]) imageMap[filename] = mod.default;
  }
}

export function getStaticPaths() {
  const modules = import.meta.glob<{ default: Record<string, any> }>('../../content/products/*.json', { eager: true });
  const slugs: string[] = [];
  for (const [path] of Object.entries(modules)) {
    slugs.push(path.split('/').pop()!.replace('.json', ''));
  }
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const productData = productMap[slug!];
const localeData = productData.el as Record<string, unknown>;
const { t } = useTranslations('el', localeData);
const title = `${localeData.name} | Ρίζος`;
const description = localeData.description as string | undefined;

const site = Astro.site ?? new URL('https://rizosdairy.gr');
const imageKey = (localeData.image as string) ?? slug!;
const ogSrc = imageMap[imageKey]
  ? (await getImage({ src: imageMap[imageKey], width: 1200, format: 'jpg', quality: 80 })).src
  : '/og-image.jpg';
const ogImage = new URL(ogSrc, site).href;

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: localeData.name,
  description: description ?? title,
  image: ogImage,
  brand: { '@type': 'Brand', name: 'Ρίζος' },
};
---

<MainLayout title={title} description={description} ogImage={ogSrc} t={t} locale='el'>
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <ProductDetailContent t={t} locale='el' slug={slug!} />
</MainLayout>
